---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Hero from "@/components/Hero.astro";
import Presentation from "@/components/Presentation.astro";
import Projects from "@/components/Projects.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Home" lang="en">
	<Header/>
	<Hero subtitle="Apprentice of Everything"/>
	<Presentation
		presTitle = "Hi, My name is Julio! 👋"
		presParagraph = {[
			"I'm a software enthusiast whos loves building things and being busy with my own problems and solving them.",
			"I've studied a Computer Technician and learned a lot of technologies to confront the world! And maybe you're thinking... What this guy made up?",
			"Glad you asked (I hope so...) take a look! 👇"
			]}
		presBtnText = "See my projects"
		knowTitle = "My knowledges"
		knowSelectLabel = "Select one"/>
	<Projects/>
	<Footer/>
</Layout>