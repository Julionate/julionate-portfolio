---
import { LoaderCircle } from "lucide-react";
import { Knowledges } from "@/components/Knowledges";
import { Button } from "@/components/ui/button";
import { defaultLocale } from "@/data/locales";
import Section from "@/layouts/Section.astro";
import { isLang } from "@/lib/isLang";

type Props = {
	presTitle: string;
	presParagraph: string | string[];
	presBtnText: string;
	knowTitle: string;
	knowSelectLabel: string;
};

const { presTitle, presParagraph, presBtnText, knowTitle, knowSelectLabel } =
	Astro.props as Props;

const currentLang = Astro.currentLocale ?? defaultLocale;
const lang = isLang(currentLang) ? currentLang : defaultLocale;

const paragraphs = Array.isArray(presParagraph)
	? presParagraph
	: [presParagraph];
---

<Section id="presentation" class="grid grid-cols-1 lg:grid-cols-2 items-center lg:gap-12">
    <div class="text-pretty prose prose-slate dark:prose-invert">
        <h1 class="font-bold text-center lg:text-start">{presTitle}</h1>
        {paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
        ))}
        <Button className="cursor-pointer">{presBtnText}</Button>
    </div>
    <div class="prose dark:prose-invert prose-h2:m-0 prose-p:m-0">
        <h1 class="font-bold text-center">{knowTitle}</h1>
        <Knowledges selectBtnLabel={knowSelectLabel} lang={lang} client:only>
            <div slot="fallback" class="h-50.75">
                <LoaderCircle className="mx-auto animate-spin size-8"></LoaderCircle>
            </div>
        </Knowledges>
    </div>
</Section>