---
import type { Entries } from "type-fest";
import { LanguageButton } from "@/components/LanguageButton";
import { ThemeButtonManager } from "@/components/ThemeButtonManager";
import { availableLocales, defaultLocale } from "@/data/locales";
import { getRelativeLocaleUrl } from "@/lib/getUrl";
import { isLang } from "@/lib/isLang";
import type { LocaleWithUrl } from "@/types/Locales";

const localesWithUrl: LocaleWithUrl[] = [];

const locales = Object.entries(availableLocales) as Entries<
	typeof availableLocales
>;

locales.forEach(([code, name]) => {
	const url = getRelativeLocaleUrl(code, "/");
	localesWithUrl.push({ code, name, url });
});

const currentLang = Astro.currentLocale ?? defaultLocale;
const lang = isLang(currentLang) ? currentLang : defaultLocale;
---

<header class="flex items-center justify-end shadow-md dark:shadow-white/5 z-50 h-12 px-3 fixed w-screen">
    <div class="flex gap-2">
        <LanguageButton locales={localesWithUrl} lang={lang} client:load></LanguageButton>
        <ThemeButtonManager client:load></ThemeButtonManager>
    </div>
</header>