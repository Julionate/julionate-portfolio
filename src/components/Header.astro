---
import { i18n } from "astro:config/client";
import { getRelativeLocaleUrl, toCodes } from "astro:i18n";
import { LanguageButton } from "@/components/LanguageButton";
import { ThemeButtonManager } from "@/components/ThemeButtonManager";
import type { Language } from "@/types/Languages";
import type { Locale } from "@/types/Locales";

let languages: Language[] = [];

if (i18n?.locales) {
	const codes = toCodes(i18n.locales) as Locale[];

	codes.forEach((code) => {
		const url = getRelativeLocaleUrl(code);
		languages.push({ code, url });
	});
}
---

<header class="flex items-center justify-end shadow-md dark:shadow-white/5 z-50 h-12 px-3 fixed w-screen">
    <div class="flex gap-2">
        <LanguageButton buttonText="Language" locales={languages} client:load></LanguageButton>
        <ThemeButtonManager client:load></ThemeButtonManager>
    </div>
</header>