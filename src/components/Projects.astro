---
import { Image } from "astro:assets";
import { GitHub } from "@/assets/icons";
import { Card } from "@/components/Card";
import { Button } from "@/components/ui/button";
import { Projects as ProjectsData } from "@/data/projects";
import Section from "@/layouts/Section.astro";

const data = Object.entries(ProjectsData.en);
// Takes the first element of the array.
// So the first entry it's always the featured content. Keep it in mind.
const featured = data.shift()?.[1];
---
<Section id="projects" class="flex flex-col items-center justify-center">
    <div class="prose dark:prose-invert">
        <h1 class="mt-6 mb-6">My Projects</h1>
    </div>

    <div class="w-full max-w-6xl grid justify-items-center">
        <div class="w-full flex flex-col items-center">
            {featured !== undefined ? (
                <div class="relative mb-6 group">
                    <Image src={featured.imageUrl} alt={featured.imageAlt} class="rounded-lg aspect-video object-cover max-w-4xl"></Image>
                    <div class="pointer-events-none absolute inset-0 bg-linear-to-b from-transparent to-background group-hover:opacity-0 transition-opacity ease-in-out duration-500" />
                </div>
                <div class="prose dark:prose-invert text-center">
                    <h1 class="mb-3">{featured.name}</h1>
                    <p class="mt-0 mb-3">{featured.description}</p>
                    <a href={featured.url}>
                        <Button variant="default" className="cursor-pointer"><GitHub className="fill-primary-foreground"/>See on Github</Button>
                    </a>
                </div>
                <div class="my-12 flex w-full text-nowrap items-center pointer-events-none select-none">
                    <div class="bg-border grow h-px"/>
                    <span class="px-6 text-muted-foreground">More projects</span>
                    <div class="bg-border grow h-px"/>
                </div>
            ) : null}
        </div>
        <Card content={data} client:idle>
    </div>
</Section>