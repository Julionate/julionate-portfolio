---
import { Image } from "astro:assets";
import { Projects as ProjectsData } from "@/data/projects";
import Section from "@/layouts/Section.astro";

const data = Object.entries(ProjectsData.en);
// Takes the first element of the array.
// So the first entry it's always the featured content. Keep it in mind.
const featured = data.shift()?.[1];
---
<Section id="projects" class="flex flex-col items-center justify-center">
    <div class="prose dark:prose-invert">
        <h1 class="mt-6 mb-6">My Projects</h1>
    </div>

    <div class="w-full max-w-6xl grid justify-items-center">
        <div>
            {featured !== undefined ?
            <div class="group">
                <div class="relative mb-6">
                    <Image src={featured.imageUrl} alt={featured.imageAlt} class="rounded-lg aspect-video object-cover"></Image>
                    <div class="pointer-events-none absolute inset-0 bg-linear-to-b from-transparent to-background group-hover:opacity-0 transition-opacity ease-in-out duration-500" />
                </div>
                <div class="prose dark:prose-invert prose-p:mt-3 prose-p:mb-12  prose-headings:m-0">
                    <h1>{featured.name}</h1>
                    <p>{featured.description}</p>
                </div>
            </div> : null}
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 justify-items-center">
            {data.map(([_, value]) => 
                <div class="bg-card shadow-lg shadow-accent/85 dark:shadow-accent/25 w-full h-96 md:h-64 flex flex-col rounded-lg overflow-hidden border">
                    <Image src={value.imageUrl} alt={value.imageAlt} class="h-1/2 aspect-video object-cover"/>
                    <div class="prose prose-slate dark:prose-invert prose-headings:m-0 prose-p:mt-2 m-2">
                        <h1 class="text-lg">{value.name}</h1>
                        <p class="text-base text-ellipsis overflow-hidden line-clamp-3">{value.description}</p>
                    </div>
                </div>
            )}
        </div>
    </div>
</Section>